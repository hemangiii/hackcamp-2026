# Copy to .env.local (ignored by git) and fill in.
# These Auth0 values are public by design (the browser needs them), so they
# are not secrets. Never put a client secret, Resend key or any other
# credential in the frontend.

# Auth0 → Applications → (your Single Page Application) → Settings
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Auth0 → APIs → (the backend API) → Identifier; must match AUTH0_AUDIENCE in backend/server/.env
VITE_AUTH0_AUDIENCE=

# Where the backend runs
VITE_API_URL=http://localhost:3000

# Leave Auth0 empty, or set this, to click through on sample data
# VITE_USE_SAMPLE_DATA=true
